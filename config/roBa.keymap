#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;

    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // NOTE: This layer reflects the CURRENT on-device state as read directly
        // from ZMK Studio on 2026-09-13. It has diverged substantially from the
        // original kumamuk-git/zmk-config-roBa template because of live edits
        // made in ZMK Studio (which only patches flashed keycodes and cannot be
        // seen from GitHub). Some behaviors that used to be hold-taps / layer-taps
        // (e.g. "I", "Z", "SPACE") have been simplified to plain key presses.
        default_layer {
            bindings = <
&kp Q         &kp W         &kp E     &kp R    &kp T                          &kp Y         &kp U    &kp I    &kp O    &kp P
&kp A         &kp S         &kp D     &kp F    &kp G        &mkp MB1                &kp LS(SLASH)  &kp H    &kp J    &kp K    &kp L    &kp RETURN
&kp Z         &kp X         &kp C     &kp V    &kp B        &trans                  &kp TAB        &kp N    &kp M    &kp COMMA &kp DOT &kp BACKSPACE
&kp LEFT_ALT  &kp LEFT_WIN  &kp LCTRL &mo 1    &kp SPACE    &kp LEFT_SHIFT          &kp LEFT_SHIFT &kp LCTRL                            &mo 6
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // NOTE: On the live device this layer no longer holds F-+eys (those moved
        // to layer "NUM" below). It now holds the number row, bracket/backslash/
        // quote/semicolon symbols, a few arrow keys, and Esc. Several of the
        // symbol keys below (', ;, {, }, \, `) use the plain/unshifted US keycode;
        // whether each produces the intended character under a JIS Windows layout
        // has not been re-verified since this layer was rebuilt in Studio.
        FUNCTION {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                          &kp NUMBER_8      &kp NUMBER_9  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp APOSTROPHE
&kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp NUMBER_5                  &kp LEFT_BRACKET  &kp MINUS     &kp LEFT_ARROW     &kp UP_ARROW   &kp RIGHT_ARROW  &kp SEMICOLON
&kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp LS(GRAVE) &trans                        &kp SLASH         &kp MINUS     &trans             &kp DOWN_ARROW &trans           &kp DEL
&kp F3        &kp F5        &kp F12       &trans        &kp ESCAPE    &trans                        &kp LEFT_SHIFT    &kp GRAVE                                                        &trans
            >;
        };

        // NOTE: On the live device this layer now holds F-keys plus a simplified
        // numpad (instead of the original heavy symbol layer). The "=" / "-" keys
        // here are the plain Keyboard page keycodes (same position under JIS/US).
        NUM {
            bindings = <
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                 &kp EQUAL     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans              &kp NUMBER_8  &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &trans              &kp SLASH     &kp MINUS     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans   &trans   &trans   &trans   &trans   &trans              &trans        &trans                                                    &trans
            >;
        };

        // NOTE: Rebuilt on the live device as an emacs/readline-style navigation
        // layer (Home / Ctrl+A / Up / Ctrl+E / End, plus duplicated arrow keys),
        // and the two floating inner keys on the left hand are bound to the
        // trackball's right-click (MB3). No key on default_layer / FUNCTION / NUM
        // / MOUSE currently activates this layer (no &mo/&lt targets it) - as far
        // as could be found it is presently unreachable except from within
        // ZMK Studio itself.
        ARROW {
            bindings = <
&trans          &kp LCTRL  &trans  &kp LEFT_ARROW  &kp RIGHT_ARROW               &kp HOME  &kp LC(A)  &kp UP_ARROW    &kp LC(E)  &kp END
&trans          &kp LEFT_SHIFT  &trans  &trans  &trans  &mkp MB3            &trans  &kp LEFT_ARROW  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans          &kp LEFT_GUI  &trans  &trans  &trans  &mkp MB3            &trans  &kp LEFT_ARROW  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &trans
&trans          &trans  &trans  &trans  &trans  &trans              &trans  &trans                                                &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        // NOTE: The original MB1/MB2/MB3 click bindings that used to live here
        // are gone; MB1 (left click) now lives directly on default_layer instead.
        // Only a stray Ctrl+A / Ctrl+E pair remain (mirroring the ARROW layer).
        // automouse-layer = <4> on &trackball still auto-activates this layer
        // when the ball moves, but almost everything on it is currently &trans.
        MOUSE {
            bindings = <
&trans  &trans  &trans     &trans  &trans                      &trans  &kp LC(A)  &trans  &kp LC(E)  &trans
&trans  &trans  &trans     &trans  &trans  &trans      &trans  &trans  &trans     &trans  &trans     &trans
&trans  &trans  &trans     &trans  &trans  &trans      &trans  &trans  &trans     &trans  &trans     &trans
&trans  &trans  &trans     &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // NOTE: BT profile selection (row 1) is unchanged from the template.
        // "R" and "Q" (row 2 left hand) are custom shortcuts unrelated to
        // Bluetooth (Ctrl+Shift+Alt+R and Ctrl+Win+Q) that were added here.
        // The bootloader / BT_CLR / BT_CLR_ALL keys that used to live on the
        // thumb row are gone - there is currently no keymap-based way to enter
        // the bootloader or clear a Bluetooth profile; use the physical reset
        // button / double-tap-reset instead.
        layer_6 {
            bindings = <
&trans  &trans                &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp LC(LS(LA(R)))     &trans        &trans        &trans  &kp LC(LG(Q))       &trans        &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1          &kp NUMBER_2  &kp NUMBER_3  &trans  &trans              &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans                &trans        &trans        &trans  &trans              &trans        &trans                                                    &trans
            >;
        };
    };
};
